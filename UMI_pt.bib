@article{hountondji_knowledge_2009,
	title = {Knowledge of Africa, Knowledge by Africans: Two Perspectives on African Studies},
	volume = {1},
	rights = {https://creativecommons.org/licenses/by/4.0/},
	issn = {1647-3175},
	url = {https://journals.openedition.org/rccsar/174},
	doi = {10.4000/rccsar.174},
	shorttitle = {Knowledge of Africa, Knowledge by Africans},
	abstract = {How African are the so-called African Studies? The study of Africa, as developed so far by a long intellectual tradition, is part of an overall project of knowledge accumulation initiated and controlled by the West. This article advocates an active, lucid, responsible appropriation by African societies themselves of the knowledge capitalised over centuries about them. It advocates more generally the development in Africa of an autonomous, self-reliant tradition of research and knowledge that addresses problems and issues directly or indirectly posed by Africans. It calls upon “épistémologies du Sud.” It calls upon African scholars in African Studies and in all other disciplines to understand that they have been doing so far a kind of research that was massively extraverted, i. e. externally oriented, intended first and foremost to meet the theoretical and practical needs of Northern societies. It invites a new orientation and new ambitions for research by Africans in Africa.},
	journaltitle = {{RCCS} Annual Review},
	shortjournal = {rccsar},
	author = {Hountondji, Paulin J.},
	urldate = {2026-06-29},
	date = {2009},
	langid = {english},
	file = {PDF:/Users/marcel/Zotero/storage/Z7IM3GCQ/Hountondji - 2009 - Knowledge of Africa, Knowledge by Africans Two Perspectives on African Studies.pdf:application/pdf},
}
